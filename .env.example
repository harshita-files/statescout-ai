# StateScout AI — environment template.
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.

# ---------------------------------------------------------------------------
# Graph persistence — Neo4j (Track D)
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=statescout
NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# Visited-set / rate-limit cache — Redis (Track D)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Perception — VLM provider (Track C)
# The orchestrator never talks to a provider directly; it calls PerceptionPort.
# ---------------------------------------------------------------------------
VLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Orchestrator — Track B. Every one of these maps to a field in
# apps/agent/orchestrator/config.py; env always overrides the default.
# ---------------------------------------------------------------------------
STATESCOUT_DEPTH_LIMIT=5
STATESCOUT_MAX_STATES=200
STATESCOUT_PERCEPTION_RATE_PER_MIN=15
STATESCOUT_CHECKPOINT_DIR=.statescout/checkpoints
STATESCOUT_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Reporting API (Track D)
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
