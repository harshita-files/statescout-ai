{
  "name": "statescout-vscode",
  "displayName": "StateScout AI",
  "publisher": "statescout-ai",
  "description": "Run policy-aware UI audits and review forbidden interface states without leaving the editor.",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:statescout.sidebarView",
    "onCommand:statescout.startScan",
    "onCommand:statescout.stopScan",
    "onCommand:statescout.openConsole"
  ],
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "node ./scripts/package-vsix.mjs --build-only",
    "package": "node ./scripts/package-vsix.mjs"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "statescout-sidebar",
          "title": "StateScout AI",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "statescout-sidebar": [
        {
          "type": "webview",
          "id": "statescout.sidebarView",
          "name": "StateScout AI Console"
        }
      ]
    },
    "commands": [
      {
        "command": "statescout.startScan",
        "title": "StateScout: Start Scan"
      },
      {
        "command": "statescout.stopScan",
        "title": "StateScout: Stop Scan"
      },
      {
        "command": "statescout.openConsole",
        "title": "StateScout: Open Audit Console"
      }
    ]
  },
  "dependencies": {
    "@statescout/shared-types": "workspace:*"
  },
  "license": "MIT"
}
